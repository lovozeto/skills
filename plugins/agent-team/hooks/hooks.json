{
  "description": "agent-team guardrails, active only in repos with .claude/agent-team.json. SessionStart names missing tools (gh, kb). PreToolUse: guard_ticket gates the ticket working files and asks the owner before the ready-for-agent label; guard_write_scope keeps each agent in its write scope; guard_knowledge blocks an agent whose mapped knowledge files kb stale lists.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/preflight.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_ticket.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_write_scope.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_knowledge.py\"", "timeout": 15 }
        ]
      }
    ]
  }
}
