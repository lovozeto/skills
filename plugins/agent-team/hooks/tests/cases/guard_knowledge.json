{
  "hook": "guard_knowledge.py",
  "cases": [
    {
      "name": "an agent whose knowledge is fresh passes",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}",
        "{dir:plain}/kb/ux/forms.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow"
    },
    {
      "name": "an agent with an expired KB file is blocked with the refresh",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}",
        "{dir:plain}/kb/ux/forms.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[{\"ref\":\"ux/forms\",\"reason\":\"expired\"}]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block",
      "reason": "kb-pipeline --refresh ux"
    },
    {
      "name": "a plugin-prefixed agent is checked under its short name",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}",
        "{dir:plain}/kb/ux/forms.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[{\"ref\":\"ux/forms\",\"reason\":\"expired\"}]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "agent-team:ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block"
    },
    {
      "name": "a stale file the agent does not map does not block it",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}",
        "{dir:plain}/kb/ux/forms.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[{\"ref\":\"ux/laws\",\"reason\":\"expired\"},{\"ref\":\"k:brand/reference-board\",\"reason\":\"no review_by\"}]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow"
    },
    {
      "name": "an expired repo knowledge file is blocked",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ui\": {\"repo\": [\"brand/guidelines\"]}}}",
        "{dir:plain}/k/.claude/knowledge/brand/guidelines.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[{\"ref\":\"k:brand/guidelines\",\"reason\":\"expired\"}]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ui",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block",
      "reason": "update their review_by"
    },
    {
      "name": "a repo file under another project name still matches",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ui\": {\"repo\": [\"brand/guidelines\"]}}}",
        "{dir:plain}/k/.claude/knowledge/brand/guidelines.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[{\"ref\":\"k-agent-team:brand/guidelines\",\"reason\":\"no review_by\"}]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ui",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block"
    },
    {
      "name": "a mapped KB file that does not exist is blocked",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/missing\"]}}}"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block",
      "reason": "does not exist"
    },
    {
      "name": "a mapped repo file that does not exist is blocked",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ui\": {\"repo\": [\"brand/absent\"]}}}"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ui",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "block",
      "reason": "does not exist"
    },
    {
      "name": "an agent mapped to no files passes with a note",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {}}}"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow",
      "context": "not KB-backed"
    },
    {
      "name": "an agent absent from the map passes silently",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "pm",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow"
    },
    {
      "name": "a kb that fails passes with a note",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}",
        "{dir:plain}/kb/ux/forms.md": "# x\n"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/kb",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]",
        "KB_STUB_EXIT": "1"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow",
      "context": "could not run"
    },
    {
      "name": "a machine without the global KB passes with a note",
      "project": "{dir:plain}/k",
      "files": {
        "{dir:plain}/k/.claude/agent-team.json": "{\"knowledge\": {\"ux\": {\"kb\": [\"ux/forms\"]}}}"
      },
      "env": {
        "CLAUDE_KB_DIR": "{dir:plain}/nowhere",
        "AGENT_TEAM_KB": "{tests}/stubs/kb",
        "KB_STUB_STALE": "[]"
      },
      "payload": {
        "tool_name": "Agent",
        "cwd": "{dir:plain}/k",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow",
      "context": "not found on this machine"
    },
    {
      "name": "a repo without agent-team.json is not touched",
      "project": "{repo:feature}",
      "payload": {
        "tool_name": "Agent",
        "cwd": "{repo:feature}",
        "tool_input": {
          "subagent_type": "ux",
          "prompt": "x",
          "description": "x"
        }
      },
      "expect": "allow"
    },
    {
      "name": "a malformed payload passes (fails open)",
      "stdin": "not json",
      "expect": "allow"
    }
  ]
}