#!/usr/bin/env bash
# Fake opencode: `models` lists ids; `run` echoes the model and the prompt it received.
if [[ "$1" == "models" ]]; then
  printf '%s\n' opencode/beam-free opencode/deepseek-v4.1-flash-free opencode/big-paid google/gemini-3.1-flash-lite
  exit 0
fi
model=""; while [[ $# -gt 0 ]]; do [[ "$1" == "--model" ]] && model="$2"; shift; done
echo "RAN model=$model prompt=$(cat)"
