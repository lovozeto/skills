#!/usr/bin/env bash
# delegation-pull-model — pull ONE model into Ollama under a short name, with its context
# window pinned. Every model must enter this way: without `PARAMETER num_ctx`, Ollama runs at
# 4096 tokens and truncates prompts silently.
#
# Usage: delegation-pull-model <short-name> <num_ctx> <source>
#   source:
#     hf.co/<repo>:<quant>    pulled, re-created as <short-name>, the long name removed
#     <ollama-library-name>   pulled and re-pinned (removed only when it differs from the short name)
#     https://…/<file>.gguf   downloaded and imported (repos where one quant tag matches several files)
# Skips a model already on disk under <short-name>. Run it only after the user agreed to the
# download (several GB).
# Exit: 0 done or skipped · 1 pull or import failed · 2 bad arguments or ollama missing.

set -uo pipefail

if [[ "$#" -ne 3 || ! "$2" =~ ^[0-9]+$ ]]; then
  echo "delegation-pull-model: usage: delegation-pull-model <short-name> <num_ctx> <source>" >&2
  exit 2
fi
NAME="$1"; CTX="$2"; SRC="$3"
command -v ollama >/dev/null || { echo "delegation-pull-model: ollama not found." >&2; exit 2; }

if ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$NAME"; then
  echo "Already on disk: $NAME" >&2
  exit 0
fi

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
if [[ "$SRC" == https://* ]]; then
  echo "Downloading $SRC ..." >&2
  curl -fL -o "$TMP/model.gguf" "$SRC" || { echo "Could not download $SRC." >&2; exit 1; }
  printf 'FROM %s\nPARAMETER num_ctx %s\n' "$TMP/model.gguf" "$CTX" > "$TMP/Modelfile"
  ollama create "$NAME" -f "$TMP/Modelfile" || { echo "Could not import $SRC." >&2; exit 1; }
else
  echo "Pulling $SRC ..." >&2
  ollama pull "$SRC" || { echo "Could not pull $SRC (check the repo and quant)." >&2; exit 1; }
  ollama show --modelfile "$SRC" | grep -v '^PARAMETER num_ctx' > "$TMP/Modelfile"
  echo "PARAMETER num_ctx $CTX" >> "$TMP/Modelfile"
  ollama create "$NAME" -f "$TMP/Modelfile" || { echo "Could not create $NAME." >&2; exit 1; }
  [[ "$SRC" != "$NAME" ]] && ollama rm "$SRC" >/dev/null
fi
echo "Ready: $NAME (num_ctx $CTX)" >&2
