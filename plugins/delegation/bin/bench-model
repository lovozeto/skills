#!/usr/bin/env bash
# bench-model — measure one model on the delegation benchmark and compare it with the
# models measured before on this machine.
#
# Tasks ship in the plugin (bench/code, bench/text); $DELEGATION_BENCH_TASKS points to another
# folder with the same layout (code/tasks.sh, text/tasks.py).
#   code: agentic tasks through `ask-opencode --model <m> --dir <tmp>`; each checker compiles
#         and runs the result. Tasks whose compiler is missing are skipped.
#   text: tasks through `ask-local` (or `ask-opencode` text mode for cloud models).
#   fit:  local models only: 100% on the GPU at the pinned context, and no hidden reasoning.
#
# Usage:
#   bench-model <model> [--tasks code|text|fit|all] [--only t1,t2] [--runs N]
#               [--current <model> --class code|text]
#   <model>: an Ollama name (qwen3:14b or ollama/qwen3:14b), or a free cloud id.
#   --runs N      repeat every code and text task N times (finalists: 3)
#   --current M   after the run, decide whether <model> should replace M for --class
#
# Results: one TSV per model in $DELEGATION_BENCH_DIR (default ~/.local/share/delegation/bench),
# rows: date, model, class, task, seconds, pass|fail|skip, note. The rows of the latest date
# count, averaged. T5's rewrite is saved as <model>_T5.txt for a human tone check.
# Exit: 0 after a run (whatever the scores) · 2 = bad arguments, or no tasks found.

set -uo pipefail

SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
ASK_LOCAL="${BENCH_ASK_LOCAL:-$ROOT/bin/ask-local}"
ASK_OPENCODE="${BENCH_ASK_OPENCODE:-$ROOT/bin/ask-opencode}"
TASKS_DIR="${DELEGATION_BENCH_TASKS:-$ROOT/bench}"
OUT_DIR="${DELEGATION_BENCH_DIR:-$HOME/.local/share/delegation/bench}"

usage() { echo "bench-model: usage: bench-model <model> [--tasks code|text|fit|all] [--only t1,t2] [--runs N] [--current <model> --class code|text]" >&2; exit 2; }
MODEL=""; CLASSES="all"; ONLY=""; RUNS=1; CURRENT=""; CLASS=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*) [[ "$#" -ge 2 ]] || usage
      case "$1" in
        --tasks) CLASSES="$2" ;; --only) ONLY="$2" ;; --runs) RUNS="$2" ;;
        --current) CURRENT="$2" ;; --class) CLASS="$2" ;; *) usage ;;
      esac; shift 2 ;;
    *) MODEL="$1"; shift ;;
  esac
done
[[ -n "$MODEL" && "$CLASSES" =~ ^(code|text|fit|all)$ && "$RUNS" =~ ^[1-9][0-9]*$ ]] || usage
[[ -n "$CURRENT" && ! "$CLASS" =~ ^(code|text)$ ]] && usage
if [[ ! -f "$TASKS_DIR/code/tasks.sh" || ! -f "$TASKS_DIR/text/tasks.py" ]]; then
  echo "bench-model: no tasks in $TASKS_DIR (expected code/tasks.sh and text/tasks.py)." >&2
  exit 2
fi
[[ "$MODEL" != */* ]] && MODEL="ollama/$MODEL"
[[ -n "$CURRENT" && "$CURRENT" != */* ]] && CURRENT="ollama/$CURRENT"
wants() { [[ "$CLASSES" == all || "$CLASSES" == "$1" ]]; }

mkdir -p "$OUT_DIR"
STEM="$OUT_DIR/$(printf '%s' "$MODEL" | tr '/:' '__')"
OUT="$STEM.tsv"
TODAY="$(date +%F)"
row() { printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$TODAY" "$MODEL" "$@" | tee -a "$OUT"; }

TIMEOUT=""
for t in timeout gtimeout; do command -v "$t" >/dev/null && { TIMEOUT="$t 600"; break; }; done
[[ -z "$TIMEOUT" ]] && echo "bench-model: no timeout command (timeout/gtimeout): a hung model blocks the run." >&2

if wants fit && [[ "$MODEL" == ollama/* ]]; then
  python3 "$ROOT/bench/probe.py" "${MODEL#ollama/}" |
    while IFS=$'\t' read -r task secs result note; do row fit "$task" "$secs" "$result" "$note"; done
fi

for (( run = 1; run <= RUNS; run++ )); do
  if wants code; then
    # shellcheck source=/dev/null
    source "$TASKS_DIR/code/tasks.sh"
    if [[ -n "$ONLY" ]]; then IFS=',' read -r -a TASKS <<< "$ONLY"; else TASKS=("${TASKS_ALL[@]}"); fi
    WORK="$(mktemp -d)"
    for t in "${TASKS[@]}"; do
      [[ -n "$t" ]] || continue
      if ! declare -F "setup_$t" >/dev/null; then echo "bench-model: unknown code task '$t'" >&2; continue; fi
      missing=""
      for tool in $(tools_for "$t"); do
        if [[ "$tool" == tsc ]]; then [[ -n "${TSC:-}" ]] || missing+="tsc "
        else command -v "$tool" >/dev/null || missing+="$tool "; fi
      done
      if [[ -n "$missing" ]]; then row code "$t" 0 skip "missing: ${missing% }"; continue; fi
      W="$WORK/$t"; mkdir -p "$W"; "setup_$t" "$W"; p="$(eval "printf '%s' \"\$P_$t\"")"
      s=$(date +%s)
      # shellcheck disable=SC2086  # TIMEOUT is a command plus its argument, or empty
      $TIMEOUT "$ASK_OPENCODE" --model "$MODEL" --dir "$W" "$p" >"$W.out" 2>"$W.err"; rc=$?
      secs=$(( $(date +%s) - s ))
      if [[ "$("check_$t" "$W" 2>/dev/null)" == 1 ]]; then row code "$t" "$secs" pass ""
      else row code "$t" "$secs" fail "exit $rc"; fi
    done
    rm -rf "$WORK"
  fi
  if wants text && [[ -z "$ONLY" ]]; then
    python3 "$TASKS_DIR/text/tasks.py" run "$MODEL" "$ASK_LOCAL" "$ASK_OPENCODE" "${STEM}_T5.txt" |
      while IFS=$'\t' read -r task secs result note; do row text "$task" "$secs" "$result" "$note"; done
  fi
done
[[ "$MODEL" == ollama/* ]] && command -v ollama >/dev/null && ollama stop "${MODEL#ollama/}" >/dev/null 2>&1

echo
if [[ -n "$CURRENT" ]]; then
  python3 "$ROOT/bench/compare.py" "$OUT_DIR" "$MODEL" --current "$CURRENT" --class "$CLASS"
else
  python3 "$ROOT/bench/compare.py" "$OUT_DIR" "$MODEL"
fi
