#!/usr/bin/env bash
# delegation-machine-info — describe this Mac for /delegation:init. Read-only: changes nothing.
#
# Output (KEY=VALUE, one per line):
#   UUID          hardware UUID (matches a machine profile)
#   CHIP          CPU brand, e.g. "Apple M4 Pro"
#   RAM_GB        unified memory in GB (integer)
#   MACOS         macOS version
#   DISK_FREE_GB  free space on the volume holding $HOME (models need several GB each)
#   BREW / OLLAMA / OPENCODE   yes | no: installed and on the PATH
#   OLLAMA_UP     yes | no: the Ollama server answers on $OLLAMA_HOST_URL (default 127.0.0.1:11434)
# macOS only for now; Linux is planned.

set -uo pipefail

have() { command -v "$1" >/dev/null 2>&1 && echo yes || echo no; }
echo "UUID=$(ioreg -rd1 -c IOPlatformExpertDevice 2>/dev/null | awk -F'"' '/IOPlatformUUID/{print $4}')"
echo "CHIP=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo unknown)"
echo "RAM_GB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 / 1024 ))"
echo "MACOS=$(sw_vers -productVersion 2>/dev/null || echo unknown)"
echo "DISK_FREE_GB=$(df -k "$HOME" 2>/dev/null | awk 'NR==2 {print int($4 / 1024 / 1024)}')"
echo "BREW=$(have brew)"
echo "OLLAMA=$(have ollama)"
echo "OPENCODE=$(have opencode)"
curl -sf --max-time 3 "${OLLAMA_HOST_URL:-http://127.0.0.1:11434}/api/version" >/dev/null 2>&1 \
  && echo "OLLAMA_UP=yes" || echo "OLLAMA_UP=no"
