+        # PATCH: USDB now appends a hash to the zip filename (e.g. user-playlist-<hash>.zip).
+        # The constructed download_url (no hash) 404s; parse the real URL from the ZIP_SAVE page.
+        import re as _re
+        _m = _re.search(r'(data/downloads/[^"\']+\.zip[^"\']*)', r.text)
+        download_url = 'https://usdb.animux.de/' + _m.group(1) if _m else download_url
         r = self.SESSION.get(download_url)
         if not r.ok: raise ConnectionError
 
